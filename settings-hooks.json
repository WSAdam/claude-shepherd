{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" sessionstart" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" userpromptsubmit" } ] }
    ],
    "PreToolUse": [
      { "matcher": "", "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" pretooluse" },
        { "type": "command", "command": "bash \"$HOME/.claude/cc-approve.sh\"", "timeout": 130 }
      ] },
      { "matcher": "AskUserQuestion", "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/cc-ask.sh\"", "timeout": 3630 }
      ] },
      { "matcher": "EnterWorktree", "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/cc-worktree-guard.sh\"" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" posttooluse" } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" posttoolusefailure" } ] }
    ],
    "PermissionRequest": [
      { "matcher": "", "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" permissionrequest" },
        { "type": "command", "command": "bash \"$HOME/.claude/cc-popup.sh\" \"${CLAUDE_PROJECT_DIR:-$PWD}\" approval" }
      ] }
    ],
    "Notification": [
      { "matcher": "", "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" notification" },
        { "type": "command", "command": "bash \"$HOME/.claude/cc-popup.sh\" \"${CLAUDE_PROJECT_DIR:-$PWD}\" approval" }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" stop" },
        { "type": "command", "command": "bash \"$HOME/.claude/cc-popup.sh\" \"${CLAUDE_PROJECT_DIR:-$PWD}\" complete" }
      ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" stopfailure" } ] },
      { "matcher": "rate_limit", "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/cc-resume.sh\"", "async": true, "asyncRewake": true, "timeout": 691200 }
      ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" precompact" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash \"$HOME/.claude/cc-status.sh\" sessionend" } ] }
    ]
  }
}
