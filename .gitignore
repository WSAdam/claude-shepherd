# macOS / editor
.DS_Store
*.swp
*~
.vscode/
.idea/

# Secrets / env (never commit)
.env
.env.*
*.pem
*-service-account*.json

# Claude Shepherd runtime + local state (created at use, not part of the repo)
cc-status/
cc-queue/
cc-approved/
cc-autopilot/
cc-config.json
# ...but the installer's default settings ship with the repo (2026-09-17)
!/defaults/cc-config.json
cc-labels.json
cc-recent-dirs.json
*.decision
.panel-alive
.debug.log
cc-gate.enabled
settings.local.json
*.bak

# Shepherd.app Dock launcher — generated by `make app` (osacompile + icon)
Shepherd.app/
*.icns

# Parallel-worktree workflow. TODO.md is Shepherd's verify-me list (My List imports it),
# never committed -- and an UNTRACKED copy in a linked worktree makes `git worktree remove`
# refuse, while an ignored one doesn't. Worktrees Claude Code creates itself live under
# .claude/worktrees/ and must not show up as untracked noise.
TODO.md
.claude/worktrees/

# Page snapshots the Playwright MCP writes into the session's cwd (2026-09-22)
.playwright-mcp/

# The companion VS Code extension's packages (make bridge builds them here).
/build/

# Another project parked inside this checkout (2026-09-19). 27MB of an unrelated repo, its
# own .env inside it, sat untracked in the root -- one `git add -A` from being published in
# this public repo. A checkout inside a checkout is always a mistake, never a commit; anchored
# to the root so a folder of that name deeper in the tree is unaffected.
/Chargeback-sdks/

# Internal to our own work on Shepherd -- a fresh install never needs these (2026-09-17)
Scratch-pad/
docs/feature-mining/
docs/orchestrator-next.md
docs/hardware-verification.md
todos.md

# The suite serialises itself per checkout (tests/run-lock.test.sh)
tests/.run.lock
