# SHIPPED -- every file the installers copy out of this checkout, one per line: its name, where it
# goes (claude = ~/.claude, hs = ~/.hammerspoon), and `hook` for a Claude Code hook script that
# settings-hooks.json wires. install.sh, uninstall.sh, the Makefile's install target and the tests
# all read this list; core.OUR_HOOK_SCRIPTS names the same hooks (tests/core.test.lua checks).
# Shipping a new script is one line here (plus its wiring in settings-hooks.json for a hook).
cc-lib.sh             claude
cc-status.sh          claude hook
cc-approve.sh         claude hook
cc-popup.sh           claude hook
cc-merge.sh           claude
cc-fleet.sh           claude
cc-ask.sh             claude hook
cc-commits.sh         claude
cc-worktree-guard.sh  claude hook
cc-core.lua           claude hs
claude-dashboard.lua  hs
